+// Neo8's caller stops keystore2 before taking this snapshot. SQLite only opens
+// the temporary copy, so it cannot create SHM or checkpoint the installed DB.
+bool KeystoreInfo::backupDatabase(const std::string& source, const std::string& destination) {
+	const auto slash = destination.find_last_of('/');
+	if (slash == std::string::npos || source == destination)
+		return false;
+	char parent[PATH_MAX];
+	if (!realpath(destination.substr(0, slash).c_str(), parent) ||
+		std::string(parent).compare(0, 5, "/tmp/") != 0)
+		return false;
+	struct stat source_stat = {}, dest_stat = {};
+	if (stat(source.c_str(), &source_stat) != 0 || !S_ISREG(source_stat.st_mode))
+		return false;
+	if (lstat(destination.c_str(), &dest_stat) == 0 &&
+		(!S_ISREG(dest_stat.st_mode) ||
+		 (source_stat.st_dev == dest_stat.st_dev && source_stat.st_ino == dest_stat.st_ino)))
+		return false;
+	char temp[] = "/tmp/neo8-keystore-XXXXXX";
+	if (!mkdtemp(temp))
+		return false;
+	const std::string snapshot = std::string(temp) + "/persistent.sqlite";
+	auto cleanup = [&]() {
+		for (const char* suffix : {"", "-wal", "-shm", "-journal"})
+			unlink((snapshot + suffix).c_str());
+		rmdir(temp);
+	};
+	auto copy = [&](const std::string& from, const std::string& to, bool optional) {
+		struct stat before = {}, after = {};
+		if (stat(from.c_str(), &before) != 0)
+			return optional && errno == ENOENT;
+		if (!S_ISREG(before.st_mode))
+			return false;
+		std::ifstream input(from, std::ios::binary);
+		std::ofstream output(to, std::ios::binary | std::ios::trunc);
+		if (!input || !output)
+			return false;
+		if (before.st_size != 0)
+			output << input.rdbuf();
+		output.close();
+		return !input.bad() && !output.fail() && stat(from.c_str(), &after) == 0 &&
+			before.st_dev == after.st_dev && before.st_ino == after.st_ino &&
+			before.st_size == after.st_size &&
+			before.st_mtim.tv_sec == after.st_mtim.tv_sec &&
+			before.st_mtim.tv_nsec == after.st_mtim.tv_nsec;
+	};
+	if (!copy(source, snapshot, false) || !copy(source + "-wal", snapshot + "-wal", true)) {
+		cleanup();
+		return false;
+	}
+	sqlite3 *input = nullptr, *output = nullptr;
+	bool success = false;
+	// Create the temporary result with private permissions before SQLite opens it.
+	int output_fd = open(destination.c_str(), O_RDWR | O_CREAT | O_NOFOLLOW, 0600);
+	if (output_fd < 0) {
+		cleanup();
+		return false;
+	}
+	if (fchmod(output_fd, 0600) != 0) {
+		close(output_fd);
+		cleanup();
+		return false;
+	}
+	close(output_fd);
+	if (sqlite3_open_v2(snapshot.c_str(), &input, SQLITE_OPEN_READWRITE, nullptr) == SQLITE_OK &&
+		sqlite3_open_v2(destination.c_str(), &output,
+			SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, nullptr) == SQLITE_OK) {
+		sqlite3_backup* backup = sqlite3_backup_init(output, "main", input, "main");
+		if (backup) {
+			const int rc = sqlite3_backup_step(backup, -1);
+			const int finish = sqlite3_backup_finish(backup);
+			success = rc == SQLITE_DONE && finish == SQLITE_OK;
+		}
+	}
+	if (input)
+		sqlite3_close(input);
+	if (output)
+		sqlite3_close(output);
+	cleanup();
+	return success;
+}
