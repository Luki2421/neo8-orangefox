+// Adapted from the Neo8 TWRP 1.1 child-mount cleanup. Only normal unmounts:
+// lazy/forced detachment must not disguise a live mount before flashing.
+static bool UnmountVendorSubdirectories(const std::string& parent) {
+	FILE* mounts = setmntent("/proc/mounts", "r");
+	if (!mounts) {
+		LOGINFO("Cannot inspect mounts under '%s': %s (errno=%d)\n",
+			parent.c_str(), strerror(errno), errno);
+		return false;
+	}
+	const std::string prefix = parent + "/";
+	std::vector<std::string> children;
+	while (mntent* entry = getmntent(mounts)) {
+		const std::string path(entry->mnt_dir);
+		if (path.compare(0, prefix.size(), prefix) == 0)
+			children.push_back(path);
+	}
+	const bool read_failed = ferror(mounts);
+	endmntent(mounts);
+	if (read_failed) {
+		LOGINFO("Cannot read complete mount table for '%s'\n", parent.c_str());
+		return false;
+	}
+	std::sort(children.begin(), children.end(), [](const std::string& a, const std::string& b) {
+		return a.size() > b.size();
+	});
+	for (const auto& child : children)
+		LOGINFO("Submount under '%s': '%s'\n", parent.c_str(), child.c_str());
+	for (const auto& child : children) {
+		if (umount2(child.c_str(), 0) != 0) {
+			const int error = errno;
+			// Another recovery operation may already have removed this mount.
+			if (error == EINVAL || error == ENOENT)
+				continue;
+			LOGINFO("Cannot unmount child '%s': %s (errno=%d); leaving '%s' mounted\n",
+				child.c_str(), strerror(error), error, parent.c_str());
+			return false;
+		}
+	}
+	return true;
+}
