+static zip_type GetInstallZipType(ZipArchiveHandle zip) {
+	ZipEntry64 entry;
+	// Keep the dispatch order: a ZIP with both entries runs update-binary.
+	if (FindEntry(zip, std::string(UPDATE_BINARY_NAME), &entry) == 0)
+		return UPDATE_BINARY_ZIP_TYPE;
+	if (FindEntry(zip, std::string(AB_OTA), &entry) == 0)
+		return AB_OTA_ZIP_TYPE;
+	if (FindEntry(zip, std::string("ui.xml"), &entry) == 0)
+		return TWRP_THEME_ZIP_TYPE;
+	return UNKNOWN_ZIP_TYPE;
+}
