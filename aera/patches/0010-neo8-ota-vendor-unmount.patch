+static std::string UnescapeMountinfoPath(const std::string& path) {
+	std::string result;
+	for (size_t i = 0; i < path.size(); i++) {
+		if (path[i] == '\\' && i + 3 < path.size() &&
+			path[i + 1] >= '0' && path[i + 1] <= '3' && path[i + 2] >= '0' && path[i + 2] <= '7' &&
+			path[i + 3] >= '0' && path[i + 3] <= '7') {
+			result.push_back(static_cast<char>((path[i + 1] - '0') * 64 + (path[i + 2] - '0') * 8 + (path[i + 3] - '0')));
+			i += 3;
+		} else {
+			result.push_back(path[i]);
+		}
+	}
+	return result;
+}
+
+// Returns the mounts under parent that sit on top of parent's active (topmost)
+// mount, deepest first. Mounts under parent that were made before parent was
+// mounted are covered by it and do not block its unmount, so they are left
+// alone: on the Neo8 the Wi-Fi configuration binds live under the ramdisk
+// /vendor and stay valid when the stock vendor partition is unmounted again.
+// Returns false when the mount table cannot be parsed.
+static bool CollectBlockingSubmounts(const std::string& mountinfo, const std::string& parent,
+		std::vector<std::string>& children, std::vector<std::string>& covered) {
+	struct Mount { std::string dir; int parent_id; };
+	std::unordered_map<int, Mount> mounts;
+	std::vector<int> order;
+	std::istringstream lines(mountinfo);
+	std::string line;
+	while (std::getline(lines, line)) {
+		if (line.empty())
+			continue;
+		std::istringstream fields(line);
+		int id = 0, parent_id = 0;
+		std::string device, root, dir;
+		if (!(fields >> id >> parent_id >> device >> root >> dir))
+			return false;
+		mounts[id] = {UnescapeMountinfoPath(dir), parent_id};
+		order.push_back(id);
+	}
+	// The active mount of parent is the one no other parent mount is stacked on.
+	int top = -1;
+	for (int id : order) {
+		if (mounts[id].dir != parent)
+			continue;
+		bool covered_by_other = false;
+		for (int other : order)
+			if (other != id && mounts[other].dir == parent && mounts[other].parent_id == id)
+				covered_by_other = true;
+		if (!covered_by_other)
+			top = id;
+	}
+	if (top < 0)
+		return true;
+	const std::string prefix = parent + "/";
+	for (int id : order) {
+		const std::string& dir = mounts[id].dir;
+		if (dir.compare(0, prefix.size(), prefix) != 0)
+			continue;
+		bool above_top = false;
+		int current = mounts[id].parent_id;
+		for (int depth = 0; depth < 256 && mounts.count(current); depth++) {
+			if (current == top) {
+				above_top = true;
+				break;
+			}
+			if (mounts[current].parent_id == current)
+				break;
+			current = mounts[current].parent_id;
+		}
+		(above_top ? children : covered).push_back(dir);
+	}
+	std::stable_sort(children.begin(), children.end(), [](const std::string& a, const std::string& b) {
+		return a.size() > b.size();
+	});
+	return true;
+}
+
+static bool ReadSelfMountinfo(std::string& text) {
+	std::ifstream file("/proc/self/mountinfo");
+	if (!file)
+		return false;
+	std::stringstream buffer;
+	buffer << file.rdbuf();
+	if (file.bad())
+		return false;
+	text = buffer.str();
+	return true;
+}
+
+// Adapted from the Neo8 TWRP 1.1 child-mount cleanup. Only normal unmounts:
+// lazy/forced detachment must not disguise a live mount before flashing.
+static bool UnmountVendorSubdirectories(const std::string& parent) {
+	std::string mountinfo;
+	std::vector<std::string> children, covered;
+	if (!ReadSelfMountinfo(mountinfo)) {
+		LOGINFO("Cannot inspect mounts under '%s': %s (errno=%d)\n",
+			parent.c_str(), strerror(errno), errno);
+		return false;
+	}
+	if (!CollectBlockingSubmounts(mountinfo, parent, children, covered)) {
+		LOGINFO("Cannot parse the mount table for '%s'\n", parent.c_str());
+		return false;
+	}
+	for (const auto& child : covered)
+		LOGINFO("Mount '%s' is covered by the active '%s' mount; leaving it\n",
+			child.c_str(), parent.c_str());
+	for (const auto& child : children)
+		LOGINFO("Submount under '%s': '%s'\n", parent.c_str(), child.c_str());
+	for (const auto& child : children) {
+		if (umount2(child.c_str(), 0) != 0) {
+			const int error = errno;
+			// Another recovery operation may already have removed this mount.
+			if (error == EINVAL || error == ENOENT)
+				continue;
+			LOGINFO("Cannot unmount child '%s': %s (errno=%d); leaving '%s' mounted\n",
+				child.c_str(), strerror(error), error, parent.c_str());
+			return false;
+		}
+	}
+	return true;
+}
