 // /* Decrypt_User_Synth_Pass is the TWRP C++ equivalent to spBasedDoVerifyCredential
 //  * https://android.googlesource.com/platform/frameworks/base/+/android-8.0.0_r23/services/core/java/com/android/server/locksettings/LockSettingsService.java#1998 */
+// Android 16: an empty LSKF has an active protector but no PasswordData file.
+// Missing DE storage, an unreadable file, or an invalid handle is not proof of this.
+static bool Neo8_Default_Protector(const std::string& directory, const std::string& handle) {
+	if (handle.empty() || handle.size() > 16 ||
+			handle.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos ||
+			handle.find_first_not_of('0') == std::string::npos)
+		return false;
+	struct stat st = {};
+	if (lstat(directory.c_str(), &st) != 0 || !S_ISDIR(st.st_mode))
+		return false;
+	std::vector<std::string> prefixes = {directory + handle, directory + "0" + handle,
+		directory + "00" + handle};
+	std::string active;
+	for (const auto& prefix : prefixes) {
+		if (lstat((prefix + ".pwd").c_str(), &st) == 0 || errno != ENOENT)
+			return false;
+		if (lstat((prefix + ".spblob").c_str(), &st) == 0) {
+			if (!active.empty() || !S_ISREG(st.st_mode))
+				return false;
+			active = prefix;
+		} else if (errno != ENOENT) {
+			return false;
+		}
+	}
+	if (active.empty())
+		return false;
+	std::string blob;
+	if (!android::base::ReadFileToString(active + ".spblob", &blob) || blob.size() < 30 ||
+			static_cast<unsigned char>(blob[0]) < 1 || static_cast<unsigned char>(blob[0]) > 3 ||
+			blob[1] != 0)
+		return false;
+	// Require the matching protector's auxiliary metadata; never select another handle.
+	std::string auxiliary;
+	if (lstat((active + ".weaver").c_str(), &st) == 0) {
+		return S_ISREG(st.st_mode) && android::base::ReadFileToString(active + ".weaver", &auxiliary) &&
+			auxiliary.size() == 5 && auxiliary[0] == 1;
+	}
+	if (errno != ENOENT || lstat((active + ".secdis").c_str(), &st) != 0 || !S_ISREG(st.st_mode))
+		return false;
+	return android::base::ReadFileToString(active + ".secdis", &auxiliary) && auxiliary.size() == 16384;
+}
