+		// Only the stock-reader hints or mounted stock files above are accepted.
+		// Recovery's own boot header/properties may contain 99.87.36 / 2099-12-31.
+		auto valid_patch = [](const std::string& patch) {
+			if (patch.size() != 10 || patch[4] != '-' || patch[7] != '-') return false;
+			for (size_t i = 0; i < patch.size(); ++i) {
+				if (i != 4 && i != 7 && (patch[i] < '0' || patch[i] > '9')) return false;
+			}
+			int year = std::stoi(patch.substr(0, 4));
+			int month = std::stoi(patch.substr(5, 2));
+			int day = std::stoi(patch.substr(8, 2));
+			if (year < 2000 || year >= 2099 || month < 1 || month > 12) return false;
+			const int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+			int limit = days[month - 1];
+			if (month == 2 && (year % 400 == 0 || (year % 4 == 0 && year % 100 != 0))) ++limit;
+			return day >= 1 && day <= limit;
+		};
