+int GUIAction::neo8preparedecrypt(std::string arg __unused)
+{
+	operation_start("Decrypt");
+	int status = 1;
+	if (simulate) {
+		simulate_progress_bar();
+		status = 0;
+	} else {
+#ifdef TW_NO_AUTO_DECRYPT
+		// Explicit menu action only. Never submit a credential or default password here.
+		TWPartition* data = PartitionManager.Find_Partition_By_Path("/data");
+		DataManager::SetValue(TW_CRYPTO_PWTYPE, -1);
+		DataManager::SetValue("tw_crypto_pwtype_0", -1);
+		DataManager::SetValue("tw_crypto_password", "");
+		DataManager::SetValue("tw_crypto_display", "");
+		DataManager::SetValue("tw_crypto_user_id", "0");
+		DataManager::SetValue("tw_password_fail", 0);
+		DataManager::SetValue("of_decrypt_from_menu", 1);
+		if (data && !data->Key_Directory.empty()) {
+			PartitionManager.Decrypt_Data();
+			const int type = DataManager::GetIntValue(TW_CRYPTO_PWTYPE);
+			if (data->Is_Mounted() && DataManager::GetIntValue(TW_IS_FBE) == 1 &&
+					(type == 1 || type == 2 || type == 3)) {
+				status = 0;
+			} else {
+				gui_err("neo8_prepare_failed=Unable to prepare credential metadata. No password was submitted.");
+			}
+		} else {
+			gui_err("neo8_prepare_failed=Unable to prepare credential metadata. No password was submitted.");
+		}
+#endif
+	}
+	operation_end(status);
+	return 0;
+}
