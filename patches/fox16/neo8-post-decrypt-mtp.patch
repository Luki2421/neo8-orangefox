+static void Neo8_Refresh_MTP_After_Decrypt(bool storage_ready) {
+#if defined(TW_NO_AUTO_DECRYPT) && defined(TW_HAS_MTP)
+	if (!android::base::GetBoolProperty("twrp.recovery.refresh_mtp_after_decrypt", false) ||
+		!storage_ready ||
+		DataManager::GetIntValue("tw_mtp_enabled") != 1 ||
+		(DataManager::GetIntValue("fox_use_pass") == 1 && DataManager::GetIntValue("pass_open") != 1))
+		return;
+
+	// Startup defers MTP while data is encrypted, but leaves the user's setting
+	// enabled. Start it now, or refresh an existing server after the media path changes.
+	if (PartitionManager.is_MTP_Enabled() && !PartitionManager.Disable_MTP()) {
+		LOGERR("Unable to stop MTP for decrypted storage refresh\n");
+		return;
+	}
+	if (!PartitionManager.Enable_MTP()) {
+		LOGERR("Unable to enable MTP after decryption; storage remains unlocked\n");
+		PartitionManager.Disable_MTP();
+	} else {
+		LOGINFO("MTP enabled with decrypted storage\n");
+	}
+#endif
+}
