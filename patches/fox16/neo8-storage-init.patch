+void TWPartitionManager::Setup_Manual_Data() {
+#if defined(TW_INCLUDE_CRYPTO) && defined(TW_NO_AUTO_DECRYPT)
+	TWPartition* data = Find_Partition_By_Path("/data");
+	if (!data || data->Key_Directory.empty()) {
+		LOGERR("Manual FBE setup requires /data with a metadata key directory\n");
+		return;
+	}
+	// Process_Fstab only parses entries. The skipped full setup used to leave
+	// /data unregistered and the manual decrypt menu hidden. Do no crypto or
+	// userdata probing here; the explicit GUI action prepares metadata later.
+	data->Can_Be_Encrypted = true;
+	data->Is_Encrypted = true;
+	data->Is_Decrypted = false;
+	data->Is_FBE = true;
+	datamedia = true;
+	data->Setup_Data_Media(false);
+	unsigned int storageid = 1 << 16;
+	for (auto* part : Partitions) {
+		if (part->Is_Storage) part->MTP_Storage_ID = ++storageid;
+	}
+	Setup_Settings_Storage_Partition(data);
+	DataManager::SetValue(TW_IS_FBE, 1);
+	DataManager::SetValue(TW_IS_ENCRYPTED, 1);
+	DataManager::SetValue(TW_IS_DECRYPTED, 0);
+	DataManager::SetValue(TW_CRYPTO_PWTYPE, -1);
+	DataManager::SetValue("neo8_manual_decrypt", 1);
+	LOGINFO("Manual FBE storage registered; waiting for explicit decrypt action\n");
+#endif
 }
 
