 		AERA_BUILD, AERA_VARIANT, AERA_MAIN_VERSION_STR, aera_build_date.c_str(), Aera_Current_Device.c_str(), AERA_CURRENT_DEV_STR, OF_CURRENT_BRANCH, getpid());
